# Copia este archivo a .env y descomenta lo que uses.
# Guion (proveedor "auto", igual que en Escalera): Ollama local si esta
# corriendo con el modelo descargado (gratis, sin clave); si no, Claude con
# ANTHROPIC_API_KEY; si no, Gemini con GOOGLE_API_KEY.
# Los valores de ejemplo tipo "sk-ant-..." se ignoran (no cuentan como clave).
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Ollama (guion con un modelo local; https://ollama.com). Probado en Intel
# Arc 140V: gemma3:4b ok (~1 min); gpt-oss:20b ok (~2.5 min); qwen3:8b y
# llama3.1:8b fallan con el prompt largo ("token repeat limit").
# CHARLA_OLLAMA_MODEL=gemma3:4b
# OLLAMA_HOST=127.0.0.1:11434
# CHARLA_OLLAMA_NUM_CTX=8192
# CHARLA_OLLAMA_NUM_PREDICT=4096
# CHARLA_OLLAMA_TIMEOUT=600
# Cuanto tiempo queda el modelo en memoria tras el guion (0 = liberarlo ya;
# util si la GPU comparte memoria con la voz clonada).
# CHARLA_OLLAMA_KEEP_ALIVE=5m
# Razonamiento en modelos que lo soportan (true/false/low/medium/high)
# CHARLA_OLLAMA_THINK=
# Lote automatico (charla-lote / run-lote.ps1): tema general por defecto
# CHARLA_BATCH_THEME=ciencia y datos curiosos

# TikTok (charla-upload): credenciales de tu app en developers.tiktok.com
# con el producto "Content Posting API" y Login Kit. TIKTOK_REDIRECT_URI
# debe ser EXACTAMENTE la Redirect URI registrada en la app (no hace falta
# que la página exista). El token OAuth se guarda en .tiktok_token.json.
# TIKTOK_CLIENT_KEY=...
# TIKTOK_CLIENT_SECRET=...
# TIKTOK_REDIRECT_URI=https://example.com/callback
# Scopes a pedir en el login (default: video.upload; charla-upload --direct
# pide tambien video.publish)
# CHARLA_TIKTOK_SCOPE=video.upload,video.publish

# Opcionales (defaults en src/charla/config.py)
# CHARLA_LANGUAGE=es
# CHARLA_WATERMARK=@sfsusers
# Audio ambiente del fondo bajo las voces (0 = sin ambiente; 0.15 suena bien)
# CHARLA_BG_VOLUME=0.0
# Carpeta (o archivo) de videos de fondo; se elige uno fijo por tema
# CHARLA_BACKGROUNDS=backgrounds
# Voces (aproximación al doblaje latino; ver voices_preview/ y README)
# CHARLA_RICK_VOICE=es-MX-JorgeNeural
# CHARLA_RICK_RATE=-5%
# CHARLA_RICK_PITCH=-20Hz
# CHARLA_MORTY_VOICE=es-US-AlonsoNeural
# CHARLA_MORTY_RATE=+14%
# CHARLA_MORTY_PITCH=+30Hz
# Chroma (recorte del verde)
# CHARLA_CHROMA_SIMILARITY=0.18
# CHARLA_CHROMA_BLEND=0.05
# Layout
# CHARLA_CHAR_SCALE=0.72
# Fuente de subtitulos (Comic Sans Bold por defecto; para el estilo del
# logo de la serie: assets/fonts/get_schwifty.ttf, sin tildes ni signos)
# CHARLA_SUB_FONT=C:/Windows/Fonts/comicbd.ttf

# Rendimiento del render
# Encoder de video: auto prueba h264_qsv (Intel Quick Sync) -> h264_nvenc
# (NVIDIA) -> libx264. Forzar con qsv | nvenc | x264.
# CHARLA_VIDEO_ENCODER=auto
# Preset de libx264 cuando se usa (ultrafast..medium)
# CHARLA_X264_PRESET=veryfast
# Turnos renderizados en paralelo (auto = nucleos/2, maximo 3)
# CHARLA_RENDER_JOBS=auto
# Copia del fondo pre-escalada a la resolucion de salida (cache, una vez)
# CHARLA_BG_PROXY=1
# Peticiones simultaneas a edge-tts
# CHARLA_EDGE_CONCURRENCY=4

# RVC (voces del doblaje; ver install-rvc.ps1)
# CHARLA_RVC_PYTHON=.rvc-venv/Scripts/python.exe
# CHARLA_RVC_MODELS=models/rvc
# CHARLA_RVC_METHOD=rmvpe
# CHARLA_RICK_RVC_PITCH=2
# CHARLA_MORTY_RVC_PITCH=10
# CHARLA_RICK_RVC_SOURCE=es-MX-DaliaNeural
# CHARLA_MORTY_RVC_SOURCE=es-MX-DaliaNeural

# Voz clonada (ver install-xtts.ps1, install-chatterbox.ps1, COLAB_XTTS.md)
# Motor de voz por defecto (UI, charla y charla-lote): edge | xtts | chatterbox
# CHARLA_TTS=edge
# CHARLA_RICK_EXAGGERATION=0.7
# CHARLA_MORTY_EXAGGERATION=0.6
# CHARLA_XTTS_PYTHON=.xtts-venv/Scripts/python.exe
# CHARLA_CHATTERBOX_PYTHON=.chatterbox-venv/Scripts/python.exe
# CHARLA_XTTS_MODELS=models/xtts
# CHARLA_XTTS_REFS=voices_preview/reales
# Dispositivo de torch para la voz clonada: auto | cpu | xpu | cuda
# (xpu = GPU Intel Arc; requiere .\install-chatterbox.ps1 -Xpu y apuntar
# CHARLA_CHATTERBOX_PYTHON a .chatterbox-xpu-venv/Scripts/python.exe;
# medido en Arc 140V: ~1.7x mas rapido que la CPU)
# CHARLA_TTS_DEVICE=auto
# Hilos de CPU para torch (auto = nucleos/2: los P-cores en Intel hibridos)
# CHARLA_TORCH_THREADS=auto

# ===========================================================================
# Escalera (escalator) - ver README, seccion "Estudio y modalidades"
# ===========================================================================
# Carpeta de sus videos dentro del estudio
# ESCALATE_OUTPUT=output/escalera
# Copia este archivo a ".env" y rellena tus claves.
# Los scripts y la app lo cargan automaticamente desde la raiz del repo.

# Claude — reescrituras de texto por nivel (OPCIONAL: si no la pones, los
# textos se generan con Gemini usando la clave de Google de abajo).
# Consigue tu clave en: https://console.anthropic.com/

# Gemini — imagenes por estilo y, si no hay clave de Claude, tambien los textos
# Consigue tu clave en: https://aistudio.google.com/apikey
# Puedes usar GOOGLE_API_KEY o GEMINI_API_KEY (cualquiera de las dos vale;
# si defines ambas, GOOGLE_API_KEY tiene prioridad).

# Opcionales (tienen valores por defecto):
# Idioma de los textos y la narracion (por defecto espanol)
# ESCALATE_LANGUAGE=es
# Voz del narrador (por defecto masculina espanola, grave y pausada)
# ESCALATE_VOICE=es-ES-AlvaroNeural
# Ajustes para que suene mayor: mas lento y mas grave
# ESCALATE_VOICE_RATE=-8%
# ESCALATE_VOICE_PITCH=-12Hz
# Volumen de la musica de fondo (0 = sin musica)
# ESCALATE_MUSIC_VOLUME=0.25
# Fuente: track = pistas CC-BY de incompetech (por defecto);
# synth = ambiente sintetizado local, inmune a bloqueos de copyright
# ESCALATE_MUSIC_SOURCE=track
# Marca de agua abajo a la izquierda (por defecto "@sfsusers"; tambien
# configurable por ejecucion con --watermark / --no-watermark o en la UI)
# ESCALATE_WATERMARK=@sfsusers

# --- Modo local (sin APIs de pago) ---------------------------------------
# Texto: auto = Ollama local si esta activo, si no Claude, si no Gemini
# ESCALATE_TEXT_PROVIDER=auto
# ESCALATE_OLLAMA_MODEL=gpt-oss:20b   # qwen3:8b: ~10x faster, flatter style
# OLLAMA_HOST=http://localhost:11434
# Imagenes: auto = flux-kontext local si hay PyTorch XPU, si no gemini
#   flux-kontext (local, mejor calidad, minutos) | sdxl-face (local, rapido) | gemini
# ESCALATE_IMAGE_PROVIDER=auto
# Voz: kokoro (local) | edge (online)
# ESCALATE_TTS_PROVIDER=kokoro
# ESCALATE_KOKORO_VOICE=em_alex
# Encoder de video: auto (Intel Quick Sync si esta disponible) | x264
# ESCALATE_ENCODER=auto
# Movimiento por escena: none | rotate3d | liveportrait
# ESCALATE_MOTION=none
# Carpeta y video guia de LivePortrait (los crea setup-liveportrait.ps1)
# ESCALATE_LIVEPORTRAIT_DIR=%LOCALAPPDATA%\escalator\LivePortrait
# ESCALATE_LIVEPORTRAIT_DRIVING=assets/examples/driving/d6.mp4
