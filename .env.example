# Copia este archivo a .env y rellena al menos una clave.
# Claude escribe el guion si hay ANTHROPIC_API_KEY; si no, se usa Gemini.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# Opcionales (defaults en src/charla/config.py)
# CHARLA_LANGUAGE=es
# CHARLA_WATERMARK=@sfsusers
# CHARLA_BG_VOLUME=0.15
# Voces (aproximación al doblaje latino; ver voices_preview/ y README)
# CHARLA_RICK_VOICE=es-MX-JorgeNeural
# CHARLA_RICK_RATE=-5%
# CHARLA_RICK_PITCH=-20Hz
# CHARLA_MORTY_VOICE=es-US-AlonsoNeural
# CHARLA_MORTY_RATE=+14%
# CHARLA_MORTY_PITCH=+30Hz
# Chroma (recorte del verde)
# CHARLA_CHROMA_SIMILARITY=0.18
# CHARLA_CHROMA_BLEND=0.05
# Layout
# CHARLA_CHAR_SCALE=0.72
# Fuente de subtitulos (Comic Sans Bold por defecto; para el estilo del
# logo de la serie: assets/fonts/get_schwifty.ttf, sin tildes ni signos)
# CHARLA_SUB_FONT=C:/Windows/Fonts/comicbd.ttf
# RVC (voces del doblaje; ver install-rvc.ps1)
# CHARLA_RVC_PYTHON=.rvc-venv/Scripts/python.exe
# CHARLA_RVC_MODELS=models/rvc
# CHARLA_RVC_METHOD=rmvpe
# CHARLA_RICK_RVC_PITCH=2
# CHARLA_MORTY_RVC_PITCH=10
# CHARLA_RICK_RVC_SOURCE=es-MX-DaliaNeural
# CHARLA_MORTY_RVC_SOURCE=es-MX-DaliaNeural
# XTTS (voz clonada; ver install-xtts.ps1 y COLAB_XTTS.md)
# CHARLA_TTS=edge            # edge | xtts | chatterbox
# CHARLA_RICK_EXAGGERATION=0.7
# CHARLA_MORTY_EXAGGERATION=0.6
# CHARLA_XTTS_MODELS=models/xtts
# CHARLA_XTTS_REFS=voices_preview/reales
