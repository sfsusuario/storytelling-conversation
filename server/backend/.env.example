# Servidor de Storytelling Studio (api.storyteller.fierro.dev)

# Contraseña para entrar desde el teléfono/navegador (8+ caracteres)
STUDIO_PASSWORD=

# Secreto compartido con el worker del PC (24+ caracteres). El mismo valor va en
# local/.env como STUDIO_WORKER_TOKEN. install.sh lo genera si está vacío.
WORKER_TOKEN=

# Firma de las sesiones (vacío = usa WORKER_TOKEN)
SECRET_KEY=

# Orígenes extra de la web, separados por coma (CORS). storyteller.fierro.dev
# y storytelling.fierro.dev siempre están permitidos.
WEB_ORIGINS=

# 0 solo para pruebas en http://localhost
COOKIE_SECURE=1

# Copia de videos, miniaturas e historial para cuando el PC está apagado
CACHE_DIR=cache
